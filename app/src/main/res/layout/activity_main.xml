<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GeoRegistro"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sistema de Inspección de Incidencias en Terreno"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnIrRegistro"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Registrar Nueva Incidencia"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnIrListado"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Consultar Historial (Listado)"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnIrMapa"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Ver Mapa de Incidencias"
        android:layout_marginBottom="32dp"/>

    <!-- Panel del Sensor (RF06) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EFEFEF"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoreo de Sensor en Terreno (RF06)"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvEstadoSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificando sensor..."
            android:textColor="#333333"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvValoresSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="X: 0.0 | Y: 0.0 | Z: 0.0"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:textSize="15sp"/>
    </LinearLayout>

</LinearLayout>